{
  "name": "aws-cdk-infra",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all"
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1146.1",
    "jest": "^30",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "2.274.0",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/test"],
    "testMatch": ["**/*.test.ts"],
    "transform": { "^.+\\.tsx?$": ["@swc/jest"] },
    "setupFilesAfterEnv": ["aws-cdk-lib/testhelpers/jest-autoclean"]
  }
}
